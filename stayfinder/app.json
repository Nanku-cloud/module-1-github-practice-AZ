{
  "expo": {
    "name": "StayFinder",
    "slug": "stayfinder-location",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stayfinder",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StayFinder uses your location to help identify nearby travel options."
        }
      ],
      "expo-router"
    ],
    "web": {
      "bundler": "metro"
    }
  }
}